{
  "name": "hyperdeck-controller",
  "version": "1.0.0",
  "description": "HyperDeck Studio Controller",
  "main": "main.js",  
  "scripts": {
    "start": "electron .",  
    "build": "electron-builder --win --x64"  
  },
  "dependencies": {
    "bonjour-service": "^1.2.1",
    "express": "^4.19.2",
    "socket.io": "^4.7.5"
  },
  "devDependencies": {
    "electron": "^30.0.0",
    "electron-builder": "^24.13.3"
  },
  "build": {
    "appId": "com.hyperdeck.controller",
    "productName": "HyperDeck Controller",
    "directories": {
      "output": "dist"
    },
    "win": {
      "target": "portable"  
    },
    "files": [
      "server.js",
      "main.js",
      "public/**/*"
    ]
  }
}